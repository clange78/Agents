# Public site origin — used for canonicals, sitemap and absolute OG URLs.
NEXT_PUBLIC_SITE_URL=https://example.com

# Plausible (optional). Set both to enable the script tag + server-side click events.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=example.com
PLAUSIBLE_API_HOST=https://plausible.io

# GA4 Measurement Protocol (optional alternative/addition to Plausible).
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
